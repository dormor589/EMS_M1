# Copy to ".env" and fill in. The .env file is gitignored — secrets stay local.

NODE_ENV=development
# 5000 collides with macOS AirPlay Receiver.
PORT=5050

# --- Database -------------------------------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgres://localhost:5432/exam_app
# Or a managed provider (Render, Neon, Supabase). Use the EXTERNAL URL —
# an internal URL only resolves between services inside the provider:
# DATABASE_URL=postgresql://user:password@host.frankfurt-postgres.render.com/dbname
#
# TLS is auto-detected from the hostname. Override with DATABASE_SSL=true|false.

# --- Auth -----------------------------------------------------------------
# Use a long random value in production, e.g. `openssl rand -base64 32`.
JWT_SECRET=change-me
# 7 days rather than a few hours. A short-lived token is the safer default for
# a system holding real grades, but this is a course project that gets picked up
# across days — an 8-hour token meant logging in again every session.
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- AI provider (optional) -----------------------------------------------
# The AI features run in three modes, chosen automatically at startup:
#   NVIDIA_API_KEY set -> NVIDIA NIM (free key at build.nvidia.com)
#   not set            -> deterministic fallback, no network required
# Every feature works in all three modes; only the quality differs.
# NVIDIA_API_KEY=nvapi-...
NIM_MODEL=moonshotai/kimi-k3
# A faster model for exam generation and analytics summaries. Grading keeps the
# model above, where judgement matters more than latency.
NIM_FAST_MODEL=meta/llama-3.1-70b-instruct
