{
  "name": "server",
  "version": "1.0.0",
  "description": "EMS backend \u2014 Express API, PostgreSQL, JWT auth, AI grading",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:e2e": "bash scripts/e2e.sh",
    "db:reset:force": "npm run db:migrate && node src/db/seed.js --force",
    "test:watch": "vitest",
    "db:test:setup": "DATABASE_URL=postgres://localhost:5432/exam_app_test node src/db/migrate.js",
    "db:seed:class": "node src/db/seedDemoClass.js",
    "db:seed:class:dry": "node src/db/seedDemoClass.js --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
