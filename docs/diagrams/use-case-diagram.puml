@startuml EMS_UseCaseDiagram
' EMS Use Case Diagram — every capability in the delivered system.
' Milestone 1 built the exam and submission flows; Milestone 2 added the AI
' generation, AI-assisted grading, the publish gate and analytics.
' Source: the milestone brief §15.2
'
' Notes:
'   - Grade Submission is per-question and AI-assisted, behind a publish gate.
'   - Register is available to both Teacher and Student actors.

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseFontSize 12

actor Teacher
actor Student
actor "Guest\n(Unauthenticated)" as Guest

rectangle "Exam Management System" {

  ' ── Shared / Auth ─────────────────────────────────────────────────────────
  package "Authentication" {
    usecase "Register Account"    as UC_Register
    usecase "Login"               as UC_Login
    usecase "Logout"              as UC_Logout
  }

  ' ── Teacher Use Cases ────────────────────────────────────────────────────
  package "Teacher Features" {
    usecase "View Teacher Dashboard\n(counters: exams, status)" as UC_TDash
    usecase "Create Exam\n(title, duration, questions)"         as UC_Create
    usecase "Add Multiple-Choice Question"                       as UC_AddMC
    usecase "Add Open-Text Question"                             as UC_AddOT
    usecase "Edit Exam"                                          as UC_Edit
    usecase "Generate Exam with AI\n(describe it, review the draft)"  as UC_AIGen
    usecase "Run AI Grading\n(marks open answers, draft only)"        as UC_AIGrade
    usecase "Edit AI-proposed Marks"                                   as UC_EditMarks
    usecase "Publish Grade to Student"                                 as UC_Publish
    usecase "View Analytics\n(distribution, per-question difficulty)" as UC_Analytics
    usecase "Publish Exam\n(Draft -> Published)"                 as UC_Publish
    usecase "Close Exam\n(Published -> Closed)"                  as UC_Close
    usecase "View My Exams\n(list with status)"                  as UC_ExamList
    usecase "View Submissions\n(grouped by exam)"                as UC_ViewSubs
    usecase "Grade Submission\n(per question, editable)"       as UC_Grade
  }

  ' ── Student Use Cases ────────────────────────────────────────────────────
  package "Student Features" {
    usecase "View Student Dashboard\n(available / submitted / graded)" as UC_SDash
    usecase "View Available Exams\n(Published only)"                    as UC_Available
    usecase "Take Exam\n(answer questions)"                             as UC_Take
    usecase "Answer Multiple-Choice\n(radio button selection)"          as UC_AnswerMC
    usecase "Answer Open-Text\n(textarea input)"                        as UC_AnswerOT
    usecase "Auto-Save Draft Answers\n(to the server, debounced)"    as UC_Draft
    usecase "Submit Answers\n(one submission per exam)"                 as UC_Submit
    usecase "View Grades and Feedback"                                  as UC_Grades
  }

}

' ── Guest associations ───────────────────────────────────────────────────────
Guest --> UC_Register
Guest --> UC_Login

' ── Teacher associations ─────────────────────────────────────────────────────
Teacher --> UC_Login
Teacher --> UC_AIGen
Teacher --> UC_AIGrade
Teacher --> UC_EditMarks
Teacher --> UC_Publish
Teacher --> UC_Analytics
Teacher --> UC_Logout
Teacher --> UC_TDash
Teacher --> UC_Create
Teacher --> UC_Edit
Teacher --> UC_Publish
Teacher --> UC_Close
Teacher --> UC_ExamList
Teacher --> UC_ViewSubs
Teacher --> UC_Grade

UC_Create ..> UC_AddMC : <<include>>
UC_Create ..> UC_AddOT : <<include>>
UC_Edit   ..> UC_AddMC : <<include>>
UC_Edit   ..> UC_AddOT : <<include>>

' ── Student associations ─────────────────────────────────────────────────────
Student --> UC_Login
Student --> UC_Logout
Student --> UC_SDash
Student --> UC_Available
Student --> UC_Take
Student --> UC_Submit
Student --> UC_Grades

UC_Take ..> UC_AnswerMC : <<include>>
UC_Take ..> UC_AnswerOT : <<include>>
UC_Take ..> UC_Draft    : <<include>>

' ── Notes ──────────────────────────────────────────────────────────────
note as N_Publish
  Grading is teacher-triggered and two-stage:
  AI or manual marks produce a DRAFT, invisible
  to the student. Only "Publish Grade" releases it.
end note

@enduml
