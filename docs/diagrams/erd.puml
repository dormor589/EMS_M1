@startuml EMS_ERD
' EMS — Entity Relationship Diagram (Milestone 2, PostgreSQL)
' Reflects server/src/db/schema.sql exactly.
'
' Design: relational core + JSONB only where the shape genuinely varies
' (questions.options). Every other column is typed with real constraints,
' so the database is the last line of defence for the domain invariants.

hide circle
skinparam linetype ortho
skinparam roundcorner 4
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor White
  BorderColor #33556E
  ArrowColor #33556E
}

legend top
  **PK** primary key   **FK** foreign key   **UQ** unique constraint
  All ids are UUID, generated by the database.
endlegend

entity "**users**" as users {
  **PK** id : UUID
  --
  name : VARCHAR(100)
  **UQ** email : VARCHAR(255)  <<lower-case only>>
  password_hash : VARCHAR(255)  <<bcrypt>>
  role : VARCHAR(20)  <<teacher | student>>
  created_at : TIMESTAMPTZ
}

entity "**exams**" as exams {
  **PK** id : UUID
  --
  **FK** created_by : UUID → users.id
  title : VARCHAR(150)
  description : TEXT
  duration_minutes : INTEGER  <<positive>>
  passing_grade : INTEGER  <<0–100>>
  status : VARCHAR(20)  <<Draft | Published | Closed>>
  generated_by_ai : BOOLEAN
  ai_prompt : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "**questions**" as questions {
  **PK** id : UUID
  --
  **FK** exam_id : UUID → exams.id
  type : VARCHAR(20)  <<multiple-choice | open-text>>
  text : TEXT
  options : JSONB  <<array; MC only>>
  correct_answer : INTEGER  <<index; NULL for open-text>>
  weight : INTEGER  <<positive>>
  position : INTEGER
  created_at : TIMESTAMPTZ
}

entity "**submissions**" as submissions {
  **PK** id : UUID
  --
  **FK** exam_id : UUID → exams.id
  **FK** student_id : UUID → users.id
  **UQ** (exam_id, student_id)
  status : VARCHAR(20)
  <<in_progress | submitted | ai_graded | graded>>
  started_at : TIMESTAMPTZ
  expires_at : TIMESTAMPTZ  <<timer deadline>>
  submitted_at : TIMESTAMPTZ
  grade : NUMERIC(5,2)  <<0–100>>
  feedback : TEXT
  graded_by : VARCHAR(20)  <<teacher | ai | ai+teacher>>
  graded_at : TIMESTAMPTZ  <<set on publish>>
  needs_regrade : BOOLEAN
}

entity "**answers**" as answers {
  **PK** id : UUID
  --
  **FK** submission_id : UUID → submissions.id
  **FK** question_id : UUID → questions.id
  **UQ** (submission_id, question_id)
  value : TEXT  <<option index or prose>>
  is_correct : BOOLEAN  <<MC only>>
  ai_score : NUMERIC(5,2)  <<what the AI proposed>>
  ai_feedback : TEXT
  score : NUMERIC(5,2)  <<final, teacher-editable>>
  feedback : TEXT
  updated_at : TIMESTAMPTZ  <<autosave>>
}

users       ||--o{ exams       : "creates\n(teacher)"
users       ||--o{ submissions : "sits\n(student)"
exams       ||--o{ questions   : "contains"
exams       ||--o{ submissions : "receives"
submissions ||--o{ answers     : "consists of"
questions   ||--o{ answers     : "is answered by"

note bottom of answers
  One row per answered question, which is why
  per-question analytics is a plain SQL join
  rather than JSON traversal.

  ai_* holds what the model proposed; score and
  feedback hold what the teacher settled on. Keeping
  them apart is what lets the UI show
  "AI proposed 85 — you changed it to 92".
end note

note bottom of submissions
  Created when the student OPENS the exam, not when
  they submit — so this row carries the countdown and
  the autosaved answers long before it carries a grade.

  grade = sum(score x weight) / sum(weight)
  passed is derived from exams.passing_grade, never stored.
end note

@enduml
